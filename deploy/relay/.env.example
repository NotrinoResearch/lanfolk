# Lanfolk relay settings. Copy to .env next to docker-compose.yml.
# This file holds relay settings only. Never put SSH or VPS credentials here.

# Public IP or DNS name that clients connect to.
RELAY_PUBLIC_HOST=203.0.113.10
# STUN, signaling and UDP data.
RELAY_UDP_PORT=3478
# TCP fallback. If 443 is used by another service, pick another free port.
RELAY_TCP_PORT=443
# Per-session rate limit in kbit/s.
RELAY_MAX_SESSION_KBPS=2000
# Local status and metrics endpoint (/healthz, /metrics, /status).
RELAY_METRICS_ADDR=127.0.0.1:9100
# Image tag to run.
RELAY_IMAGE_TAG=latest

# Local secrets (VPS credentials). Never commit.
.env
*.env.local

# Local release build configuration (default relay host and ports). Never commit.
build.env

# Release build output (scripts/build-release.ps1)
/build/
/dist/

# Agent worktrees and local tool state
.claude/worktrees/
.claude/settings.local.json

# NAT simulation (test/natsim): Linux binaries and run output
/test/natsim/bin/
/test/natsim/out/

# go-winres output (scripts/build-release.ps1 generates it)
ui/rsrc_*.syso

# impeccable skill working files (only DESIGN.md and .impeccable/design.json are kept)
.impeccable/questions/
